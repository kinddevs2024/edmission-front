# Родительские origin (Expo Web и т.д.), которым разрешено слать postMessage AUTH_SEED во встроенный iframe.
# В dev есть встроенный список localhost; для LAN (192.168.x.x:8081) задай явно через запятую.
# VITE_EMBED_PARENT_ORIGINS=http://192.168.1.5:8081

# Оставь пустым или не задавай при работе через Nginx (один порт 8080).
# Иначе укажи URL бэкенда, например: http://localhost:4000/api
# VITE_API_URL=http://localhost:8080/api

# Google Sign-In (тот же Web Client ID, что и GOOGLE_CLIENT_ID на бэкенде)
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Yandex ID (OAuth). Для кнопки Passport SDK укажи Redirect URI: http://localhost:5173/suggest/token.html (и продакшен).
# Старый редирект-код: /auth/yandex/callback — по желанию можно оставить в кабинете для совместимости.
# VITE_YANDEX_CLIENT_ID=
# Полный URL вспомогательной страницы (если не совпадает с {origin}/suggest/token.html):
# VITE_YANDEX_SUGGEST_REDIRECT_URI=https://edmission.uz/suggest/token.html

# Sign in with Apple. This is the Apple Services ID, same value as APPLE_CLIENT_ID on backend.
# Add this redirect URL in Apple Developer: https://edmission.uz/auth/apple/callback
# For local testing also add: http://localhost:5173/auth/apple/callback
# VITE_APPLE_CLIENT_ID=com.edmission.web
# VITE_APPLE_REDIRECT_URI=https://edmission.uz/auth/apple/callback

# ElevenLabs Conversational AI support agent
# Fallback for all languages if a language-specific agent is not configured.
VITE_ELEVENLABS_AGENT_ID=agent_1201kqf99wf2f6e8q03as766twk5
VITE_ELEVENLABS_AGENT_ID_EN=
VITE_ELEVENLABS_AGENT_ID_RU=
VITE_ELEVENLABS_AGENT_ID_UZ=
